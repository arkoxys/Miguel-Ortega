rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      // Identity check: isAdmin is true if UID exists in /admins collection
      // or if email matches developer for bootstrapping
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'Arkoxys.spark@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // --- Products ---
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price > 0 &&
             data.category in ['casual', 'elegancia', 'accesorios'] &&
             data.sizes is list && data.sizes.size() > 0 &&
             data.colors is list && data.colors.size() > 0 &&
             (data.get('stock', 0) is number);
    }

    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isAdmin() && isValidProduct(incoming()) && (
        // Action: Edit details
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'category', 'sizes', 'colors', 'stock', 'images'])
      );
      allow delete: if isAdmin();
    }

    // --- Users ---
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
    }

    // --- Orders ---
    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 &&
             data.customerPhone is string && data.customerPhone.size() > 0 &&
             data.customerAddress is string && data.customerAddress.size() > 0 &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'confirmed', 'shipped', 'delivered'] &&
             data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow create: if isValidOrder(incoming()) && isValidId(orderId);
      allow read, list: if isAdmin();
      allow update: if isAdmin() && (
        // Action: Change status
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
    }

    // --- Admins ---
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Only an existing admin can add new admins
      allow write: if isAdmin();
    }
  }
}
