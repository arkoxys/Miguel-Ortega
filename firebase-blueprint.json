{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A boutique fashion item",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string", "enum": ["casual", "elegancia", "accesorios"] },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "sizes", "colors"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer purchase order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "customerZone": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "deliveryCost": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "shipped", "delivered"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "isFirstPurchase": { "type": "boolean" }
      },
      "required": ["customerName", "customerPhone", "customerAddress", "items", "total"]
    },
    "User": {
      "title": "User",
      "description": "Store customer profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "hasPurchased": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Admin": {
      "title": "Admin",
      "description": "User with administrative privileges",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store boutique items"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store customer orders"
    },
    "/users/{uid}": {
      "schema": "User",
      "description": "Store customer profiles"
    },
    "/admins/{uid}": {
      "schema": "Admin",
      "description": "Store administrator UIDs"
    }
  }
}
